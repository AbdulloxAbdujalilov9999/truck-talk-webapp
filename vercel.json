{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://truck-talk-admin.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://truck-talk-admin.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/free/:day(\\d{1,2})",
      "destination": "/free/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/trucktalk",
      "destination": "/trucktalk/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/teachers",
      "destination": "/teachers/",
      "permanent": true
    },
    {
      "source": "/drivers",
      "destination": "/drivers/",
      "permanent": true
    },
    {
      "source": "/speakup",
      "destination": "/trucktalk/",
      "permanent": true
    },
    {
      "source": "/speakup/((?!sw\\.js$).*)",
      "destination": "/trucktalk/",
      "permanent": true
    },
    {
      "source": "/free",
      "destination": "/free/1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/((?!__/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 14 * * *"
    }
  ]
}
