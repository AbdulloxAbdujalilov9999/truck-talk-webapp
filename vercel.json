{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://truck-talk-admin.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://truck-talk-admin.firebaseapp.com/__/firebase/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/trucktalk",
      "destination": "/trucktalk/",
      "permanent": true
    },
    {
      "source": "/speakup",
      "destination": "/speakup/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/teachers",
      "destination": "/teachers/",
      "permanent": true
    },
    {
      "source": "/speakup/admin",
      "destination": "/speakup/admin/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!__/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
