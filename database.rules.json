{
  "rules": {
    // Realtime Database rules have no user-defined functions (unlike
    // Firestore), so the "is this caller the owner/manager/an approved
    // teacher" check is inlined everywhere via root.child('users')... — the
    // real access-control boundary; the admin/main app UIs are convenience
    // only, nothing here trusts client-side role checks.

    "users": {
      // Owner/manager list everyone. A teacher never queries this node
      // directly — see teacherStudents below — so no broader grant here.
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')",

      "$uid": {
        // Read your own record; owner/manager read anyone's; a teacher
        // reads only the specific student records naming them as teacher.
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')) || (root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'teacher' && data.child('teacherId').val() === auth.uid))",

        // Owner: unrestricted, and the only one who can create a profile for
        // someone else (SpeakUp's admin "Add user" tool). Manager: full control
        // over existing teacher/student/pending accounts, but can never touch
        // (or create) an owner or a manager. Anyone: may still create exactly one profile — their
        // own — as either the hardcoded owner bootstrap, or (everyone else)
        // a pending request that is immediately role:"student" and has no
        // teacher yet — this is what gives a brand-new sign-up their 3-day
        // free trial of the course site (see trialInfo() in
        // shared/auth-gate.js) without waiting on approval. Turning that
        // into permanent access (any role), or cutting it short, only ever
        // happens via the owner/manager branch above, never at creation.
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'manager' && data.exists() && !(data.child('role').val() === 'owner' || data.child('role').val() === 'manager') && !(newData.exists() && (newData.child('role').val() === 'owner' || newData.child('role').val() === 'manager'))) || (auth.uid === $uid && !data.exists() && newData.child('email').val() === auth.token.email && ((auth.token.email === 'abdujalilov7707@gmail.com' && newData.child('role').val() === 'owner' && newData.child('status').val() === 'approved') || (auth.token.email !== 'abdujalilov7707@gmail.com' && newData.child('role').val() === 'student' && newData.child('status').val() === 'pending' && !newData.hasChild('teacherId')))))",

        // An approved user may always touch just these three fields of
        // their own record (name edits, presence heartbeat) — on top of,
        // not instead of, the owner/manager grant above.
        "name": { ".write": "auth != null && auth.uid === $uid" },
        "lastActive": { ".write": "auth != null && auth.uid === $uid" },
        "updatedAt": { ".write": "auth != null && auth.uid === $uid" },

        // A range of lessons opened for a student, set directly by staff
        // (owner, manager, or the student's own teacher) — no request/
        // approve step, unlike resets below: this is a live field on the
        // student's own profile, which their already-open app is already
        // listening to, so it takes effect immediately if they're online
        // (and, same as any other profile field, the next time they open
        // the app otherwise). Finishing a lesson no longer unlocks the next
        // one by itself — isUnlocked() in app.js only ever opens day 1 for
        // free; every day after that requires the student's own [unlockFrom,
        // unlockTo] range, granted here, regardless of what's been
        // completed. Restricted to student targets; a manager still can't
        // use this side door to touch an owner/manager account (there'd be
        // no effect anyway — app.js only ever reads it for a student, and
        // staff always have full access regardless of this field).
        "unlockFrom": {
          ".write": "auth != null && root.child('users').child($uid).child('role').val() === 'student' && ((root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')) || (root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 60 && (!newData.parent().hasChild('unlockTo') || newData.val() <= newData.parent().child('unlockTo').val()))"
        },
        "unlockTo": {
          ".write": "auth != null && root.child('users').child($uid).child('role').val() === 'student' && ((root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')) || (root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 60 && (!newData.parent().hasChild('unlockFrom') || newData.val() >= newData.parent().child('unlockFrom').val()))"
        },

        // SpeakUp's own early-access range (it has 90 lessons, Truck Talk 60,
        // and the two courses are unlocked independently), same rules as above.
        "spUnlockFrom": {
          ".write": "auth != null && root.child('users').child($uid).child('role').val() === 'student' && ((root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')) || (root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 90 && (!newData.parent().hasChild('spUnlockTo') || newData.val() <= newData.parent().child('spUnlockTo').val()))"
        },
        "spUnlockTo": {
          ".write": "auth != null && root.child('users').child($uid).child('role').val() === 'student' && ((root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')) || (root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 90 && (!newData.parent().hasChild('spUnlockFrom') || newData.val() >= newData.parent().child('spUnlockFrom').val()))"
        }
      }
    },

    "progress": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')) || (root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
        // Own progress only — app.js writes here. The one exception: the
        // owner/manager may delete it (when removing a restricted user).
        ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')))"
      }
    },

    // Lesson resets. Staff (owner, manager, or the student's own teacher)
    // create a request; the student's app applies it and stamps appliedAt
    // (the only thing a student may write, and only on an existing request).
    // Requests can't be edited or deleted by the student.
    "resets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))))",
        // Owner/manager may delete the whole node (removing a restricted user).
        ".write": "auth != null && !newData.exists() && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')",
        "$rid": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['kind', 'key', 'by', 'at']) && (newData.child('kind').val() === 'lesson' || newData.child('kind').val() === 'homework' || newData.child('kind').val() === 'grammar')",
          "appliedAt": { ".write": "auth != null && auth.uid === $uid && data.parent().exists() && !data.exists()" }
        }
      }
    },

    // SpeakUp (section 1 of the site, /speakup/): its per-student course data
    // lives under this namespace so it never collides with Truck Talk's own
    // progress/resets above. Accounts, roles, approval, teacher links and
    // events are shared by both courses (one sign-in, one user list). The
    // rules below are SpeakUp's own, unchanged, just one level deeper.
    "speakup": {
      "progress": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')) || (root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
          // Own progress only — app.js writes here. The one exception: the
          // owner/manager may delete it (when removing a restricted user).
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')))"
        }
      },

      // Lesson resets. Staff (owner, manager, or the student's own teacher)
      // create a request; the student's app applies it and stamps appliedAt
      // (the only thing a student may write, and only on an existing request).
      // Requests can't be edited or deleted by the student.
      "resets": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))))",
          // Owner/manager may delete the whole node (removing a restricted user).
          ".write": "auth != null && !newData.exists() && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')",
          "$rid": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['kind', 'key', 'by', 'at']) && (newData.child('kind').val() === 'lesson' || newData.child('kind').val() === 'homework' || newData.child('kind').val() === 'grammar')",
            "appliedAt": { ".write": "auth != null && auth.uid === $uid && data.parent().exists() && !data.exists()" }
          }
        }
      },

      // Modeled exactly on resets above, but in the opposite direction: a
      // teacher/manager/owner can force-mark a lesson complete for a student
      // (e.g. a legitimate pass that didn't register, or letting someone
      // skip ahead). Same request/apply/stamp flow, same access rule.
      "passes": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))))",
          // Owner/manager may delete the whole node (removing a restricted user).
          ".write": "auth != null && !newData.exists() && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')",
          "$pid": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['kind', 'key', 'score', 'by', 'at']) && newData.child('kind').val() === 'lesson' && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 100",
            "appliedAt": { ".write": "auth != null && auth.uid === $uid && data.parent().exists() && !data.exists()" }
          }
        }
      },

      // Homework assigned by a teacher/manager/owner to a specific student —
      // a day, a grammar unit, or a free-text note, with an optional due
      // date. Modeled closely on resets above: staff write a request, but
      // unlike resets there is nothing for the student's app to "apply" —
      // completion is inferred client-side from their own existing progress
      // (see isCompleted/isGrammarDone in app.js), so a student has no write
      // access here at all, not even to acknowledge it.
      "assignments": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))))",
          // Owner/manager may delete the whole node (removing a restricted user).
          ".write": "auth != null && !newData.exists() && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')",
          "$aid": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('users').child($uid).child('teacherId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['kind', 'by', 'at']) && (newData.child('kind').val() === 'day' || newData.child('kind').val() === 'grammar' || newData.child('kind').val() === 'note')"
          }
        }
      }
    },

    // Nested by teacher rather than a flat collection: RTDB has no
    // composite indexes, so "this teacher's events, in order" is just a
    // direct path read (events/{teacherId}) sorted client-side, instead of
    // a query that would need one.
    "events": {
      "$teacherId": {
        ".read": "auth != null && (auth.uid === $teacherId || (root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')))",
        ".write": "auth != null && (auth.uid === $teacherId || (root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')))"
      }
    },

    // Denormalized index: teacherStudents/{teacherId}/{studentUid} = true.
    // Lets a teacher discover which /users/{uid} records are theirs to
    // read (see users/$uid/.read above) without ever querying /users
    // directly. Kept in sync by admin.js's approveUser/setUserRole/
    // reassignTeacher whenever a student's teacherId changes.
    "teacherStudents": {
      "$teacherId": {
        ".read": "auth != null && (auth.uid === $teacherId || (root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')))",
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager')"
      }
    },

    // Truck Talk Teachers — live, Kahoot-style classroom sessions hosted
    // from teachers/. A room's slide CONTENT is never stored here (both the
    // host and every participant already have curriculum.js/grammar.js
    // loaded and derive the same slide list from source.ref client-side) —
    // only the live, interactive bits: which slide is showing, who has
    // joined, and their answers/scores. hostUid is the one field that
    // decides everything else: set once at creation (by an approved
    // owner/manager/teacher) and immovable after, it's what lets the host
    // freely write cursor/status/scores for their own room (the $code-level
    // grant below), while every other field's own narrower rule (further
    // down) is what additionally lets a participant — who is never the
    // host — write just their own join record and their own answers.
    // RTDB write grants cascade downward (a grant at a shallow path also
    // covers its children), so the host's $code-level access already
    // reaches everything in the room; the participants/answers rules exist
    // to grant *more* access to non-host callers, not to restrict the host.
    "liveClasses": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && data.child('hostUid').val() === auth.uid) || (!data.exists() && newData.child('hostUid').val() === auth.uid && root.child('users').child(auth.uid).child('status').val() === 'approved' && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'teacher')))",
        "participants": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40"
          }
        },
        "answers": {
          "$slideIndex": {
            "$pid": {
              ".write": "auth != null && auth.uid === $pid",
              ".validate": "newData.hasChildren(['choice', 'at']) && newData.child('choice').isNumber()"
            }
          }
        }
      }
    }
  }
}
