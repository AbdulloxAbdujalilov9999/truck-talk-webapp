rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'abdujalilov7707@gmail.com'; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      // Read your own profile, or (if admin) anyone's.
      allow get: if isSelf(uid) || isAdmin();
      // Only the admin can list/query all users (for the dashboard).
      allow list: if isAdmin();

      // A signed-in user may create exactly one profile: their own.
      // The email must match their verified auth email, and everyone
      // except the hardcoded admin address must self-create as a
      // pending, non-admin driver account — approval/role changes only
      // ever happen via an admin update below, never at creation.
      allow create: if isSelf(uid)
        && request.resource.data.email == request.auth.token.email
        && (
          (request.resource.data.email == 'abdujalilov7707@gmail.com'
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'approved')
          ||
          (request.resource.data.email != 'abdujalilov7707@gmail.com'
            && request.resource.data.role == 'driver'
            && request.resource.data.status == 'pending')
        );

      // The admin can change anything (approve/revoke/etc). A regular
      // user may only touch their own name and presence heartbeat —
      // never their own status or role.
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive', 'name']));

      allow delete: if isAdmin();
    }
  }
}
